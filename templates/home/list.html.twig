{% extends 'base.html.twig' %}

{% block body %}
<div class="container">
    <br>
    <h1>Liste des Questions</h1>
    <br>

    <ul class="list-unstyled">
        {% for question in pagination %}
        <li class="question-item mb-4">
            <div class="row">
                <div class="col-md-14">
                    <strong>Question {{ question.num }}:</strong><br><br>
                    <div class="question-text">
                        {{ question.enonce }} 
                    </div>
                    
                    <div>
                        <div class="form-check">
                            <input type="checkbox" id="response1_{{ question.id }}" name="responses[{{ question.id }}][]" value="{{ question.score1 }}" class="form-check-input">
                            <label class="form-check-label" for="response1_{{ question.id }}">{{ question.rep1 }}</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" id="response2_{{ question.id }}" name="responses[{{ question.id }}][]" value="{{ question.score2 }}" class="form-check-input">
                            <label class="form-check-label" for="response2_{{ question.id }}">{{ question.rep2 }}</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" id="response3_{{ question.id }}" name="responses[{{ question.id }}][]" value="{{ question.score3 }}" class="form-check-input">
                            <label class="form-check-label" for="response3_{{ question.id }}">{{ question.rep3 }}</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-5 text-right">
                    {% set gif_class = 'gif-' ~ question.num %}
                    <img src="{{ asset('User/img/questionnnn-' ~ question.num ~ '.gif') }}" 
                         alt="GIF pour la question {{ question.num }}" 
                         style="width: 100%; max-height: 300px;"
                         class="{{ gif_class }}">
                    <!-- Utilisation de style inline pour spécifier la taille et la marge -->
                </div>
            </div>
        </li>
        {% endfor %}
    </ul>

    <div class="navigation text-center mt-2"> <!-- Ajustement de la marge supérieure ici -->
        <ul class="pagination justify-content-center custom-pagination" style="margin-top: -200px;">
            <li class="page-item {% if pagination.currentPageNumber == 1 %}disabled{% endif %}">
                <a href="{% if pagination.currentPageNumber > 1 %}{{ path('questionnaire', {'page': pagination.currentPageNumber - 1}) }}{% endif %}" class="page-link btn btn-success btn-block" aria-label="Précédent">Précédent</a>
            </li>
            <li class="page-item {% if pagination.currentPageNumber == pagination.pageCount %}disabled{% endif %}">
                <a href="{% if pagination.currentPageNumber < pagination.pageCount %}{{ path('questionnaire', {'page': pagination.currentPageNumber + 1}) }}{% endif %}" class="page-link btn btn-success btn-block" aria-label="Suivant">Suivant</a>
            </li>
        </ul>
    </div>

    {% if pagination.currentPageNumber == pagination.pageCount %}
    <form>
        <button type="submit" class="btn btn-primary btn-block mt-3">Submit</button>
    </form>
    {% endif %}
</div>

<style>
    .question-text {
        margin-bottom: 10px; /* Ajoute une marge en bas du texte de la question */
    }

    .gif-3, .gif-4, .gif-5, .gif-2 {
        width: 100%; /* Largeur à 100% de son conteneur */
        max-height: 300px; /* Hauteur maximale de 300 pixels */
        float: left; /* Flotte l'image à gauche du texte */
        clear: both; /* Pour éviter le chevauchement avec le texte suivant */
        margin-right: 20px; /* Marge à droite pour l'espacement */
    }
</style>

{% endblock %}
